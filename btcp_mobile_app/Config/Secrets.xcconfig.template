// Secrets.xcconfig.template
// このファイルをコピーして Secrets.xcconfig を作成してください
// Secrets.xcconfig は .gitignore に含まれているため、gitにコミットされません
//
// 使い方:
// 1. このファイルを同じディレクトリにコピー
// 2. ファイル名を Secrets.xcconfig に変更
// 3. 各値を実際の認証情報に置き換える

// Rain API
RAIN_API_KEY = your_rain_api_key_here
RAIN_API_BASE_URL = https:/$()/api-dev.raincards.xyz/v1/issuing

// Supabase
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here

// Web3Auth
WEB3AUTH_CLIENT_ID = your_web3auth_client_id_here
WEB3AUTH_VERIFIER_NAME = your_verifier_name_here
WEB3AUTH_REDIRECT_URL = your.app.scheme:/$()/auth

// Test credentials (開発用のみ)
TEST_EMAIL = test@example.com
TEST_PASSWORD = test1234
